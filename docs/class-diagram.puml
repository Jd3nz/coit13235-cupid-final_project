@startuml

title Cupid Matching Component — UML Class Diagram

skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false
hide empty members

package "com.cupid.matching" {
  class CupidMatchingApplication <<SpringBootApplication>> {
    + {static} main(args : String[]) : void
  }
}

package "com.cupid.matching.config" {
  class MatchingProperties <<ConfigurationProperties>> {
    - swipeEncouragementEnabled : boolean
    + isSwipeEncouragementEnabled() : boolean
    + setSwipeEncouragementEnabled(value : boolean) : void
  }
}

package "com.cupid.matching.controller" {
  class HomeController <<Controller>> {
    - matchingProperties : MatchingProperties
    - userRepository : UserRepository
    + home(model : Model) : String
  }

  class DiscoveryController <<Controller>> {
    - discoveryService : DiscoveryService
    + discover(userId : Long, model : Model) : String
  }

  class SwipeController <<Controller>> {
    - swipeService : SwipeService
+ recordSwipe(request : SwipeRequest, bindingResult : BindingResult, redirectAttributes : RedirectAttributes) : String
    - redirectAfterSwipe(request : SwipeRequest) : String
  }

  class MatchController <<Controller>> {
    - discoveryService : DiscoveryService
    - matchService : MatchService
    + matches(userId : Long, model : Model) : String
  }

  class SwipeHistoryController <<Controller>> {
    - discoveryService : DiscoveryService
    - swipeHistoryService : SwipeHistoryService
    + history(userId : Long, model : Model) : String
  }
}

package "com.cupid.matching.service" {
  class DiscoveryService <<Service>> {
    - userRepository : UserRepository
    + findViewer(viewerId : Long) : Optional<User>
    + findNextProfile(viewerId : Long) : Optional<User>
  }

  class SwipeService <<Service>> {
    - userRepository : UserRepository
    - swipeRepository : SwipeRepository
    - matchRepository : MatchRepository
    + recordSwipe(request : SwipeRequest) : SwipeResult
    - validateRequest(request : SwipeRequest) : void
  }

  class MatchService <<Service>> {
    - matchRepository : MatchRepository
    + findActiveMatches(userId : Long) : List<MatchSummary>
  }

  class SwipeHistoryService <<Service>> {
    - swipeHistoryRepository : SwipeHistoryRepository
    + findHistory(userId : Long) : List<SwipeHistorySummary>
  }
}

package "com.cupid.matching.repository" {
  class UserRepository <<Repository>> {
    - jdbcTemplate : JdbcTemplate
    - userRowMapper : RowMapper<User>
    + findAllActive() : List<User>
    + findById(id : Long) : Optional<User>
    + findNextDiscoverableProfile(viewerId : Long) : Optional<User>
    + lockUserPair(firstUserId : Long, secondUserId : Long) : void
  }

  class SwipeRepository <<Repository>> {
    - jdbcTemplate : JdbcTemplate
+ saveCurrentSwipe(swiperId : Long, targetUserId : Long, decision : SwipeDecision) : void
+ saveSwipeHistory(swiperId : Long, targetUserId : Long, decision : SwipeDecision) : void
  }

  class MatchRepository <<Repository>> {
    - jdbcTemplate : JdbcTemplate
    - matchSummaryRowMapper : RowMapper<MatchSummary>
    + hasReciprocalLike(viewerId : Long, targetUserId : Long) : boolean
    + createMatch(firstUserId : Long, secondUserId : Long) : void
    + findActiveMatchesForUser(userId : Long) : List<MatchSummary>
  }

  class SwipeHistoryRepository <<Repository>> {
    - jdbcTemplate : JdbcTemplate
    - historyRowMapper : RowMapper<SwipeHistorySummary>
    + findHistoryByUserId(userId : Long) : List<SwipeHistorySummary>
  }
}

package "com.cupid.matching.dto" {
  class SwipeRequest <<validated DTO>> {
    - viewerId : Long
    - targetUserId : Long
    - decision : SwipeDecision
    + SwipeRequest()
+ SwipeRequest(viewerId : Long, targetUserId : Long, decision : SwipeDecision)
    + getViewerId() : Long
    + setViewerId(viewerId : Long) : void
    + getTargetUserId() : Long
    + setTargetUserId(targetUserId : Long) : void
    + getDecision() : SwipeDecision
    + setDecision(decision : SwipeDecision) : void
  }

  class SwipeResult <<record>> {
    + matched : boolean
    + {static} recorded() : SwipeResult
    + {static} matchCreated() : SwipeResult
  }

  class MatchSummary <<record>> {
    + matchId : Long
    + matchedUserId : Long
    + displayName : String
    + age : int
    + bio : String
    + matchedAt : OffsetDateTime
    + status : MatchStatus
  }

  class SwipeHistorySummary <<record>> {
    + historyId : Long
    + targetUserId : Long
    + displayName : String
    + age : int
    + bio : String
    + decision : SwipeDecision
    + swipedAt : OffsetDateTime
  }
}

package "com.cupid.matching.model" {
  class User {
    - id : Long
    - displayName : String
    - age : int
    - bio : String
    - active : boolean
    - createdAt : OffsetDateTime
    + getId() : Long
    + getDisplayName() : String
    + getAge() : int
    + getBio() : String
    + isActive() : boolean
    + getCreatedAt() : OffsetDateTime
  }

  enum SwipeDecision {
    LIKE
    DISLIKE
  }

  enum MatchStatus {
    ACTIVE
    UNMATCHED
  }
}

package "com.cupid.matching.exception" {
  class InvalidSwipeException <<RuntimeException>> {
    + InvalidSwipeException(message : String)
  }

  class GlobalExceptionHandler <<ControllerAdvice>> {
+ handleQueryTimeout(exception : QueryTimeoutException, model : Model) : String
+ handleConnectionFailure(exception : CannotGetJdbcConnectionException, model : Model) : String
+ handleOtherDatabaseFailure(exception : DataAccessException, model : Model) : String
  }
}

package "Spring Framework" {
  class JdbcTemplate <<framework>>
  class "RowMapper<T>" as RowMapperT <<framework>>
  class QueryTimeoutException <<framework>>
  class CannotGetJdbcConnectionException <<framework>>
  class DataAccessException <<framework>>
}

